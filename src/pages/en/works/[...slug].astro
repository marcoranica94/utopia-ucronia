---
import { getCollection } from "astro:content";
import Work from "../../../views/Work.astro";

export async function getStaticPaths() {
  return (await getCollection("works")).map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}
---
<Work work={Astro.props.work} lang="en" />
