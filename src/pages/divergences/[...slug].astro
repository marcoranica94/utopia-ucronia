---
import { getCollection } from "astro:content";
import Work from "../../views/Work.astro";
export async function getStaticPaths() {
  return (await getCollection("works"))
    .filter((work) => work.data.level === "divergence")
    .map((work) => ({ params: { slug: work.id }, props: { work } }));
}
---
<Work work={Astro.props.work} lang="it" />
