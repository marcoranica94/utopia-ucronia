---
import "@fontsource/titillium-web/latin-400.css";
import "@fontsource/titillium-web/latin-600.css";
import "@fontsource/titillium-web/latin-700.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { type Lang, localePath, useTranslations } from "../i18n";
import "../styles/base.css";

interface Props {
  title: string;
  /** Interface language; the text of a work carries its own lang attribute. */
  lang: Lang;
}
const { title, lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const bare = localePath("it", path);
// The error page has no counterpart: its language switch leads home.
const switchPath = /^\/404(\.html|\/)?$/.test(bare) ? "/" : path;
const home = localePath(lang, "/");
---
<!doctype html>
<html lang={lang}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><script is:inline src="/theme.js"></script><title>{title} | UtopiaUcronia</title></head>
  <body>
    <a class="skip" href="#content">{t("site.skip")}</a>
    <header class="site-header"><div class="site-header-inner"><a class="brand" href={home} aria-label={t("site.home")}><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 29V17M16 20 7 11M16 17l9-9M7 11 4 5M7 11l2-6M25 8l-2-5M25 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="4" cy="5" r="2" fill="currentColor"/><circle cx="9" cy="5" r="2" fill="currentColor"/><circle cx="23" cy="3" r="2" fill="currentColor"/><circle cx="29" cy="4" r="2" fill="currentColor"/></svg><span>UtopiaUcronia</span></a><nav class="site-nav" aria-label={t("site.navLabel")}><a href={home} aria-current={bare === "/" ? "page" : undefined}>{t("site.nav.works")}</a><a href={localePath(lang, "/tree/")} aria-current={bare.startsWith("/tree") ? "page" : undefined}>{t("site.nav.tree")}</a><a href="/design/" aria-current={bare.startsWith("/design") ? "page" : undefined}>{t("site.nav.preview")}</a></nav><nav class="lang-switch" aria-label={t("site.languageLabel")}><a href={localePath("it", switchPath)} hreflang="it" lang="it" aria-current={lang === "it" ? "true" : undefined}>IT</a><a href={localePath("en", switchPath)} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a></nav><ThemeToggle lang={lang} /></div></header>
    <main class="page-shell" id="content"><slot /></main>
    <footer class="site-footer"><div class="site-footer-inner"><strong>UtopiaUcronia</strong><p>{t("site.footer")}</p></div></footer>
  </body>
</html>
