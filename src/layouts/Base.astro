---
import "../styles/base.css";

interface Props {
  titolo: string;
  lingua?: string;
}
const { titolo, lingua = "it" } = Astro.props;
---
<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo} | UtopiaUcronia</title>
  </head>
  <body>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <header><a href="/">UtopiaUcronia</a><span>Archivio personale</span></header>
    <main id="contenuto"><slot /></main>
    <footer>Una raccolta di storie possibili. Edizione in preparazione.</footer>
  </body>
</html>
