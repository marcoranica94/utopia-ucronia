---
import "../styles/base.css";

interface Props {
  title: string;
  language?: string;
}
const { title, language = "en" } = Astro.props;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | UtopiaUcronia</title>
  </head>
  <body>
    <a class="skip" href="#content" lang="en">Skip to content</a>
    <header lang="en"><a href="/">UtopiaUcronia</a><span>Personal archive</span></header>
    <main id="content"><slot /></main>
    <footer lang="en">A collection of possible stories. Edition in progress.</footer>
  </body>
</html>
