---
import { readFile } from "node:fs/promises";
import type { Gap } from "../../scripts/link-resolution";
import { type Lang, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const gaps = JSON.parse(
  await readFile("reports/link-gaps.json", "utf8"),
) as Gap[];
---
<Base title={t("gaps.title")} lang={lang}>
  <div class="plain-page"><p class="page-kicker">{t("gaps.kicker")}</p><h1 class="page-title">{t("gaps.heading")}</h1><p>{t("gaps.text1")}</p><p>{t("gaps.text2")}</p><a class="back-link" href={localePath(lang, "/")}>{t("back.works")}</a></div>
  <div class="gap-register">{gaps.map(gap=><section class="gap-record" id={gap.id}><h2>{t(`gaps.reason.${gap.reason}`)}</h2><dl><dt>{t("gaps.resource")}</dt><dd>{gap.resource}</dd><dt>{t("gaps.referrer")}</dt><dd>{gap.source}</dd></dl></section>)}</div>
</Base>
<style>
.gap-register { margin-top:3rem; }
.gap-record { padding:1.5rem 0; border-top:1px solid var(--line); scroll-margin-top:1rem; }
.gap-record h2 { font-size:1.1rem; }
.gap-record:target { padding:1.5rem; border:2px solid var(--accent); border-radius:8px; background:var(--surface); }
.gap-record dt { color:var(--muted); font-size:0.85rem; }
.gap-record dd { margin:0.3rem 0 1rem; overflow-wrap:anywhere; font-size:0.9rem; }
</style>
