---
import { getCollection } from "astro:content";
import {
  buildEraTimeline,
  type TimelineWork,
  yearLabel,
} from "../era-timeline";
import {
  type ClassifiedItem,
  type FacetValue,
  facetPath,
  rangeLabel,
  vocabulary,
} from "../facet-index";
import { type Lang, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import "../styles/tree.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const timeline = buildEraTimeline(
  (await getCollection("works")) as unknown as ClassifiedItem[],
  vocabulary.eras,
);
/** Titles shown on each branch before the rest fold away. */
const SHOWN = 8;
const largest = Math.max(...timeline.eras.map((era) => era.works.length), 1);
/** Node size grows with the square root of the count: area tracks texts. */
const node = (n: number) =>
  `${(0.7 + 1.1 * Math.sqrt(n / largest)).toFixed(2)}rem`;
const range = (era: { start?: number; end?: number }) =>
  rangeLabel(era as FacetValue, lang);
const count = (n: number) =>
  n === 1 ? t("facet.one") : t("facet.count", { n });
const placed = new Set(
  [...timeline.eras, timeline.outsideTime].flatMap((era) =>
    era.works.map((w) => w.path),
  ),
).size;
const lang_ = (work: TimelineWork) =>
  work.language === "unknown" ? undefined : work.language;
---
<Base title={t("tree.title")} lang={lang}>
<div class="tree-page">
  <header class="page-intro">
    <h1 class="page-title">{t("tree.heading")}</h1>
    <p class="page-lede">{t("tree.lede")}</p>
    <p class="small-note">{t("tree.yearNote")}</p>
  </header>

  <nav class="era-jump" aria-label={t("tree.jump")}>
    <ol>
      {timeline.eras.map((era) => <li><a href={`#era-${era.id}`}>{era.label[lang]}<small>{era.works.length}</small></a></li>)}
      <li><a href="#era-outside-time">{timeline.outsideTime.label[lang]}<small>{timeline.outsideTime.works.length}</small></a></li>
    </ol>
  </nav>

  <ol class="trunk" aria-label={t("tree.trunk")}>
    {timeline.eras.map((era) => {
      const shown = era.works.slice(0, SHOWN);
      const rest = era.works.slice(SHOWN);
      const empty = era.works.length === 0;
      return (
        <li class:list={["era", { "era-empty": empty }]} id={`era-${era.id}`} style={`--node: ${node(era.works.length)}`}>
          <div class="era-head">
            <h2><a href={localePath(lang, facetPath("eras", era.id))}>{era.label[lang]}</a></h2>
            {range(era) && <p class="era-range">{range(era)}</p>}
            <p class="era-count">{count(era.works.length)}</p>
          </div>
          {!empty && (
            <div class="branches">
              <ul>
                {shown.map((work) => <li><a class="branch-title" href={localePath(lang, work.path)} lang={lang_(work)}>{work.title}</a>{work.year !== undefined && <span class="branch-year">{yearLabel(work.year, lang)}</span>}{work.authors.length > 0 && <span class="branch-authors">{work.authors.join(", ")}</span>}</li>)}
              </ul>
              {rest.length > 0 && (
                <details>
                  <summary>{t("tree.more", { n: rest.length })}</summary>
                  <ul>
                    {rest.map((work) => <li><a class="branch-title" href={localePath(lang, work.path)} lang={lang_(work)}>{work.title}</a>{work.year !== undefined && <span class="branch-year">{yearLabel(work.year, lang)}</span>}{work.authors.length > 0 && <span class="branch-authors">{work.authors.join(", ")}</span>}</li>)}
                  </ul>
                </details>
              )}
            </div>
          )}
        </li>
      );
    })}
  </ol>

  <section class="off-trunk" id="era-outside-time" aria-labelledby="outside-time-title">
    <h2 id="outside-time-title"><a href={localePath(lang, facetPath("eras", "outside-time"))}>{timeline.outsideTime.label[lang]}</a></h2>
    <p class="era-count">{count(timeline.outsideTime.works.length)}</p>
    <p class="off-note">{t("tree.outsideNote")}</p>
    <details>
      <summary>{t("tree.showAll")}</summary>
      <ul class="plain-branches">
        {timeline.outsideTime.works.map((work) => <li><a class="branch-title" href={localePath(lang, work.path)} lang={lang_(work)}>{work.title}</a>{work.authors.length > 0 && <span class="branch-authors">{work.authors.join(", ")}</span>}</li>)}
      </ul>
    </details>
  </section>

  <section class="off-trunk unplaced" aria-labelledby="unplaced-title">
    <h2 id="unplaced-title">{t("tree.unplaced")}</h2>
    <p class="era-count">{t("tree.unplacedNote", { n: timeline.unplaced.length, placed })}</p>
    <details>
      <summary>{t("tree.showAll")}</summary>
      <ul class="plain-branches">
        {timeline.unplaced.map((work) => <li><a class="branch-title" href={localePath(lang, work.path)} lang={lang_(work)}>{work.title}</a>{work.authors.length > 0 && <span class="branch-authors">{work.authors.join(", ")}</span>}</li>)}
      </ul>
    </details>
  </section>

  <p class="tree-caveat">{t("tree.caveat")} <a href={localePath(lang, "/divergences/")}>{t("tree.listaLink")}</a></p>
</div>
</Base>
