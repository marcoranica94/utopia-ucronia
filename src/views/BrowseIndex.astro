---
import periodImages from "../../data/period-images.json";
import {
  type BrowseKind,
  browse,
  browseRoot,
  groupsFor,
  periodPath,
} from "../browse/data";
import { type Lang, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import "../styles/browse.css";

interface Props {
  kind: BrowseKind;
  lang: Lang;
}
const { kind, lang } = Astro.props;
const t = useTranslations(lang);
const groups = groupsFor(kind);
const current = groups.filter((group) => !group.historical);
const historical = groups.filter((group) => group.historical);
const imageFor = (id: string) => {
  const key =
    id in periodImages.images
      ? id
      : periodImages.aliases[id as keyof typeof periodImages.aliases];
  return key ? `/periods/${key}.webp` : undefined;
};
const count = current.reduce((n, group) => n + group.count, 0);
const linked = browse.prompts.filter(
  (prompt) =>
    prompt.targets.length &&
    !historical.some((group) => group.id === prompt.group),
).length;
---
<Base title={t(`browse.${kind}.title`)} lang={lang} wide>
  <div class="browse-page browse-index-page">
    <header class="browse-heading" id="browse-title"><nav class="browse-switch" aria-label={t("browse.indexes")}><a href={localePath(lang,browseRoot("prompts"))} aria-current={kind==="prompts"?"page":undefined}>{t("browse.prompts.short")}</a><a href={localePath(lang,browseRoot("works"))} aria-current={kind==="works"?"page":undefined}>{t("browse.works.short")}</a></nav><h1>{t(`browse.${kind}.title`)}</h1><p class="browse-intro">{t(`browse.${kind}.intro`)}</p><p class="browse-count">{t(`browse.${kind}.count`,{n:count,groups:current.length})}{kind==="prompts"&&<> {t("browse.linkedCount",{n:linked})}</>}</p></header>
    <section aria-labelledby="periods-title"><h2 class="browse-section-title" id="periods-title">{t(`browse.${kind}.choose`)}</h2><ol class="period-index">{current.map(group=><li><a href={localePath(lang,periodPath(kind,group.id))}>{imageFor(group.id)&&<img class="period-illustration" src={imageFor(group.id)} alt="" width="720" height="360" loading="lazy" decoding="async"/>}<h3>{group.title[lang]}</h3><span>{t(`browse.${kind}.entries`,{n:group.count})}</span><span class="period-open" aria-hidden="true">↗</span></a></li>)}</ol></section>
    {historical.length>0&&<section class="browse-historical" aria-labelledby="historical-title"><h2 id="historical-title">{t("browse.historical")}</h2><p>{t("browse.historicalNote")}</p><ul>{historical.map(group=><li><a href={localePath(lang,periodPath(kind,group.id))}>{group.title[lang]}</a><span>{t("browse.prompts.entries",{n:group.count})}</span></li>)}</ul></section>}
    <aside class="browse-note"><h2>{t("browse.availability")}</h2><p>{t("browse.availabilityNote")}</p>{kind==="prompts"&&<p>{t("browse.noLinkNote")}</p>}</aside>
    <a class="browse-other" href={localePath(lang,browseRoot(kind==="prompts"?"works":"prompts"))}>{t(kind==="prompts"?"browse.toWorks":"browse.toPrompts")}</a>
  </div>
</Base>
