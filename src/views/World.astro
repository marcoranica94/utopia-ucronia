---
import { type Lang, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import type { WorldEntry } from "../world-index";
import "../styles/authors.css";
import "../styles/facets.css";

interface Props {
  entry: WorldEntry;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const { world, chapters, authors } = entry;
const t = useTranslations(lang);
---
<Base title={`${world.title} · ${t("worlds.title")}`} lang={lang}>
  <a class="back-link" href={localePath(lang, "/worlds/")}>{t("worlds.back")}</a>
  <header class="page-intro">
    <p class="page-kicker">{t(`worlds.form.${world.form}`)} · {t(`worlds.count.${world.form}`, { n: chapters.length })}</p>
    <h1 class="page-title" lang={world.language}>{world.title}</h1>
    {authors.length > 0 && <p class="facet-authors world-authors">{authors.join(", ")}</p>}
    <p class="page-lede">{world.description[lang]}</p>
    <div class="world-review">
      <p><strong>{t(`worlds.state.${world.review.state}`)}.</strong> {t(`worlds.formIntro.${world.form}`)}</p>
      <p>{t("worlds.evidence")}: <q lang={world.language}>{world.review.quote}</q></p>
    </div>
  </header>
  <section class="facet-section" aria-labelledby="world-chapters">
    <h2 id="world-chapters">{t(`worlds.chapters.${world.form}`)}</h2>
    <ol class="world-chapters">
      {chapters.map((chapter) => <li><a href={localePath(lang, chapter.path)} lang={chapter.language === "unknown" ? undefined : chapter.language}>{chapter.title}</a>{chapter.authors.length > 0 && <span class="facet-authors">{chapter.authors.join(", ")}</span>}</li>)}
    </ol>
  </section>
</Base>
