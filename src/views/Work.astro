---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { documentId } from "../../scripts/editorial-core";
import AuthorCredits from "../components/AuthorCredits.astro";
import "../styles/authors.css";
import WorkContents from "../components/WorkContents.astro";
import { transitionName } from "../content-path";
import { type Lang, localePath, localizeHtml, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import "../styles/reading.css";

interface Props {
  work: CollectionEntry<"works">;
  lang: Lang;
  /** Retained for links to the earlier comparison routes. */
  direction?: "a" | "b";
}
const { work, lang } = Astro.props;
const t = useTranslations(lang);
const data = work.data;
const { Content } = await render(work);
// Structured works carry interface placeholders: fill them in the reader's language.
const html = data.shape ? localizeHtml(work.rendered?.html ?? "", lang) : "";
const outline = data.outline ?? [];
const entries = outline.filter((i) => i.kind === "entry").length;
const interventions = outline.filter((i) => i.kind === "contribution").length;
const pieces = outline.filter((i) => i.kind === "piece").length;
const variants = outline.filter((i) => i.contribution === "variant").length;
// A plain story has nothing to navigate: no rail for a single "Inizio".
const showRail = outline.filter((i) => i.id !== "start").length >= 2;
const counted = (
  n: number,
  key: "stories" | "dates" | "contributions" | "variants",
) => `${n} ${t(`count.${key}.${n === 1 ? "one" : "many"}`)}`;
const facts = [
  data.shape === "collection" && counted(pieces, "stories"),
  entries > 0 && counted(entries, "dates"),
  interventions > 0 && counted(interventions, "contributions"),
  variants > 0 && counted(variants, "variants"),
].filter(Boolean);
const captured = (s?: string) =>
  s ? `${s.slice(6, 8)}/${s.slice(4, 6)}/${s.slice(0, 4)}` : undefined;
---
<Base title={data.title} lang={lang} reading>
  <a class="back-link" href={localePath(lang, "/")}>{t("back.works")}</a>
  {data.shape ? (
    <div class="uchronia">
      <div class="uchronia-main">
        <header class="uchronia-head">
          <h1 id="work-title" class="page-title" style={`view-transition-name:${transitionName(work.id)};view-transition-class:work-title`} lang={data.language === "unknown" ? "" : data.language}>{data.title}</h1>
          <AuthorCredits lang={lang} authors={data.authors} contributors={data.contributors ?? []} />
          <p class="uchronia-facts">{data.level === "divergence" ? t("shape.divergence") : t(`shape.${data.shape}`)}{facts.length > 0 && `: ${facts.join(", ")}.`} {t(`work.language.${data.language}`)}</p>
        </header>
        {showRail && <WorkContents outline={outline} lang={lang} textLang={data.language} />}
        <article class="reading-copy structured" lang={data.language === "unknown" ? "" : data.language}><Fragment set:html={html} /></article>
        <footer class="uchronia-source" id="work-sources"><h2>{t("source.title")}</h2><ul>{data.sources.map(source=><li><a data-reading-source href={localePath(lang,`/sources/${source.documentId ?? documentId(source.url)}/`)}>{t("source.open")} — {source.url.split("/").at(-1)}</a></li>)}</ul><p>{t("source.resourcesHint")}</p>
          {data.sourceHeaders && data.sourceHeaders.length > 0 && <details><summary>{t("source.originalHeading")}</summary><ul lang={data.language === "unknown" ? undefined : data.language}>{data.sourceHeaders.map(text => <li>{text}</li>)}</ul></details>}
          {data.sources.map((source) => <p>{captured(source.timestamp) ? t("work.sourceCaptured", { url: source.url, date: captured(source.timestamp) ?? "" }) : t("work.source", { url: source.url })}</p>)}
          <p>{t("work.kept")}</p>
          <p>{t("work.automatic")}</p>
        </footer>
      </div>
    </div>
  ) : (
    <div class="reading-layout"><div class="reading-main"><p class="page-kicker">{t("work.kicker")} · {data.language.toUpperCase()}</p><h1 id="work-title" class="page-title" style={`view-transition-name:${transitionName(work.id)};view-transition-class:work-title`} lang={data.language === "unknown" ? "" : data.language}>{data.title}</h1><aside class="notice">{t("work.review")} {data.gaps > 0 && <>{t("work.reviewGaps")} <a href={localePath(lang, "/gaps/")}>{t("work.reviewGapsLink")}</a>.</>}</aside><article class="reading-copy" lang={data.language === "unknown" ? "" : data.language}><Content /></article></div>
      <aside class="reading-aside" aria-labelledby="source-title"><h2 id="source-title">{t("work.provenance")}</h2><ul>{data.sources.map(source=><li><a data-reading-source href={localePath(lang,`/sources/${source.documentId ?? documentId(source.url)}/`)}>{t("source.open")}</a></li>)}</ul>{data.sources.map((source) => <div><p>{source.timestamp ? t("work.captured", { date: captured(source.timestamp) ?? "" }) : t("work.fromOrigin")}</p><p>{source.url}</p></div>)}<p>{t("work.kept")}</p></aside>
    </div>
  )}
  <a class="back-top" href="#work-title" data-back-top>↑ {t("reader.top")}</a>
  <script is:inline src="/reader.js" defer></script>
</Base>
