---
import { type Lang, useTranslations } from "../i18n";

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
const options = [
  { value: "system", label: t("theme.auto"), icon: "M12 3a9 9 0 1 0 0 18V3Z" },
  {
    value: "light",
    label: t("theme.light"),
    icon: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-6v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4",
  },
  {
    value: "dark",
    label: t("theme.dark"),
    icon: "M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z",
  },
];
---
<div class="theme-switch" role="group" aria-label={t("theme.toggle")} data-theme-switch hidden>
  {options.map((o) => (
    <button type="button" data-theme-set={o.value} aria-pressed="false" title={o.label}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={o.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" fill={o.value === "system" ? "currentColor" : "none"} /><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" style={o.value === "system" ? "" : "display:none"} /></svg>
      <span class="theme-label">{o.label}</span>
    </button>
  ))}
</div>
<style>
  .theme-switch { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .theme-switch[hidden] { display: none; }
  :global(:root[data-scripted]) .theme-switch[hidden] { display: inline-flex; }
  .theme-switch button { display: inline-flex; align-items: center; gap: .35rem; min-height: 40px; padding: .25rem .55rem; border: 0; border-radius: 6px; background: transparent; color: var(--muted); font: 600 .82rem / 1 var(--font-ui); cursor: pointer; }
  .theme-switch button:hover { color: var(--accent); }
  .theme-switch button[aria-pressed="true"] { background: var(--surface-soft); color: var(--ink); }
  .theme-switch svg { width: 16px; height: 16px; flex: none; }
  /* On narrow screens the options keep only their icons; names stay for screen readers. */
  @media (max-width: 600px) {
    .theme-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .theme-switch button { padding: .25rem .45rem; }
  }
</style>
