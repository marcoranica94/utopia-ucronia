---
import { type BrowseKind, periodPath } from "../browse/data";
import { type Lang, localePath, useTranslations } from "../i18n";

interface Props {
  kind: BrowseKind;
  group: string;
  page: number;
  pages: number;
  lang: Lang;
}
const { kind, group, page, pages, lang } = Astro.props;
const t = useTranslations(lang);
const visible = Array.from({ length: pages }, (_, index) => index + 1).filter(
  (n) => n === 1 || n === pages || Math.abs(n - page) <= 1,
);
---
{pages>1 && <nav class="browse-pager" aria-label={t("browse.pagination")}>
  {page>1?<a rel="prev" href={localePath(lang,periodPath(kind,group,page-1))}>{t("browse.previous")}</a>:<span class="pager-unavailable">{t("browse.previous")}</span>}
  <ol>{visible.map((n,index)=><>{index>0&&n>visible[index-1]+1&&<li aria-hidden="true">…</li>}<li><a href={localePath(lang,periodPath(kind,group,n))} aria-label={t("browse.page",{n})} aria-current={n===page?"page":undefined}>{n}</a></li></>)}</ol>
  {page<pages?<a rel="next" href={localePath(lang,periodPath(kind,group,page+1))}>{t("browse.next")}</a>:<span class="pager-unavailable">{t("browse.next")}</span>}
</nav>}
