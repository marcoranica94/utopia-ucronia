{
  "name": "utopia-ucronia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "board": "node scripts/generate-board.ts",
    "dev": "astro dev --host 0.0.0.0",
    "preview": "astro preview --host 0.0.0.0",
    "recovery": "node scripts/recovery/cli.ts",
    "recovery:origin": "node scripts/recovery/origin.ts",
    "convert": "node scripts/convert.ts",
    "check": "astro check",
    "build": "pnpm convert && pnpm browse:generate && pnpm sources:generate && pnpm periods:generate && astro check && astro build && pnpm browse:payloads && pnpm search:build && pnpm links:check && pnpm compare:sample && pnpm browse:check && pnpm s3:check && pnpm discovery:check",
    "compare:sample": "node scripts/compare-sample.ts",
    "test": "node --test tests/*.test.ts",
    "lint": "biome ci .",
    "links:check": "node scripts/check-links.ts",
    "backup": "node scripts/backup.ts",
    "restore:test": "node scripts/restore-test.ts",
    "deploy:verify": "node scripts/verify-access.ts",
    "editorial:map": "node scripts/generate-map.ts",
    "editorial:sample": "node scripts/select-validation.ts",
    "editorial:enrich": "node scripts/enrich-map.ts",
    "browse:generate": "node scripts/generate-browse.ts",
    "browse:check": "node scripts/check-browse.ts",
    "browse:payloads": "node scripts/generate-browse-payloads.ts",
    "sources:generate": "node scripts/generate-sources.ts",
    "search:build": "node scripts/build-search.ts",
    "discovery:check": "node scripts/check-discovery.ts",
    "s3:check": "node scripts/check-s3.ts",
    "periods:generate": "node scripts/generate-period-images.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.8",
    "@fontsource/titillium-web": "5.3.0",
    "astro": "7.4.10",
    "cheerio": "1.2.0",
    "iconv-lite": "0.7.3",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "turndown": "7.2.5",
    "unpdf": "1.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "pagefind": "1.6.0",
    "typescript": "6.0.3",
    "wrangler": "4.160.1"
  }
}
