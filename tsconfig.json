{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "archive",
    "node_modules",
    "public/pagefind",
    "public/browse-data",
    "public/periods"
  ]
}
